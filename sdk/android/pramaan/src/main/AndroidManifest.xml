        <package android:name="com.zoho.assist.agent" />
        <package android:name="com.aomei.anyviewer" />
        <package android:name="com.rsupport.mobizen.sec" />
        <package android:name="com.realvnc.server" />
        <package android:name="com.topjohnwu.magisk" />
        <package android:name="eu.chainfire.supersu" />
