# PayPal sandbox credentials for the checkout page. Copy this file to .env and fill them in.
# Get them at https://developer.paypal.com/dashboard/applications/sandbox (a free PayPal developer account is enough).
# .env is gitignored. Never commit a real secret.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional: the demo rate for charging the risk model's INR amounts in USD (PayPal's supported currencies don't include INR).
# PAYPAL_INR_PER_USD=85
